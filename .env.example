# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# Required for AI blueprint generation and the MQL5 AST repair loop.
# Without it the app falls back to a hardcoded sample blueprint.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of this deployment. Used to build the PesaPal callback URL.
# Leave unset locally and the server infers it from the request host.
APP_URL="https://forex-trading-bot-builder.vercel.app"

# Port to listen on. Most hosts inject this; defaults to 3000 locally.
PORT=3000

# Random secret (32+ chars) used to sign the entitlement and admin cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Password for the operator surface at /?view=admin (curation + roadmap).
# Leave unset and admin is unreachable rather than open.
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# PesaPal
# ---------------------------------------------------------------------------
# From your PesaPal merchant dashboard. If these are unset, /api/pesapal/checkout
# returns 503 and no payment UI is offered — it never pretends to succeed.
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# "sandbox" (default) or "live".
PESAPAL_ENV="sandbox"

# Register your IPN URL once, then paste the returned id here:
#   npm run register-ipn
# The IPN URL is https://<your-domain>/api/pesapal/ipn
PESAPAL_IPN_ID=""
